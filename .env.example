# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=your_username
DATABASE_PASSWORD=your_password
DATABASE_NAME=car_database
DATABASE_TYPE=postgresql

# API Configuration
API_ENDPOINT=https://your-api-endpoint.com/api
API_KEY=your_api_key_here
API_TIMEOUT=30

# Application Settings
LOG_LEVEL=INFO
CACHE_ENABLED=true
CACHE_DURATION=3600
MAX_SEARCH_RESULTS=100

# UI Settings
WINDOW_WIDTH=1200
WINDOW_HEIGHT=800
THEME=default

# ====================================
# 2TB SSD Storage Configuration
# ====================================

# SSD Mount Point (update based on your system)
# Windows example: D:\, E:\
# macOS example: /Volumes/ExternalSSD
# Linux example: /mnt/ssd or /media/username/SSD
SSD_MOUNT_POINT=/mnt/ssd

# Storage Quotas (in GB)
# Total = 2000GB
STORAGE_QUOTA_DATABASE=100
STORAGE_QUOTA_IMAGES=1200
STORAGE_QUOTA_CACHE=300
STORAGE_QUOTA_BACKUPS=200
STORAGE_QUOTA_EXPORTS=50
STORAGE_QUOTA_LOGS=50

# Image Storage Settings
IMAGE_MAX_ORIGINAL_SIZE=52428800
IMAGE_THUMBNAIL_WIDTH=200
IMAGE_THUMBNAIL_HEIGHT=150
IMAGE_THUMBNAIL_QUALITY=85
IMAGE_SUPPORTED_FORMATS=jpg,jpeg,png,gif,bmp,webp

# Cache Settings
CACHE_MAX_SIZE=107374182400
CACHE_TTL=604800
CACHE_CLEANUP_INTERVAL=3600

# Backup Settings
AUTO_BACKUP_ENABLED=true
BACKUP_INTERVAL=86400
MAX_BACKUPS=10
BACKUP_COMPRESSION_ENABLED=true

# Performance Settings
MAX_CONCURRENT_UPLOADS=5
MAX_CONCURRENT_DOWNLOADS=5
BATCH_SIZE=1000
PREFETCH_IMAGES=true

# Maintenance Settings
AUTO_CLEANUP_ENABLED=true
CLEANUP_INTERVAL=604800
DELETE_OLD_CACHE_DAYS=30
DELETE_OLD_LOGS_DAYS=90
